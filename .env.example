# Copy to .env and fill in what you have. Never commit .env.

# Gemini free tier: https://aistudio.google.com/apikey  (no card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq free tier (Llama 3.3 70B): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Llama through Ollama (optional): https://ollama.com  then  ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Order to try providers in
PROVIDER_ORDER=gemini,groq,ollama

# Only if Chrome is not auto-detected
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
